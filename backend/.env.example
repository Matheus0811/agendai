# Copie este arquivo para ".env" e ajuste se precisar.

# Em desenvolvimento usamos SQLite (um arquivo local). Em produção, use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/agendai
DATABASE_URL=sqlite:///./agendai.db

# Gere uma chave forte para produção:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-troque-esta-chave-antes-de-publicar

ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true = cria a barbearia de demonstração ao iniciar, se ela ainda não existir
SEED_DEMO=false
